{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-connect.local/schema/files.schema.json",
  "title": "Files channel (0x07) commands, events and binary frames",
  "description": "JSON negotiation uses the envelope. Binary data frames (mtype 0x10) carry: u32be transfer_id, u64be offset, then up to 65536 bytes of file content. SHA-256 of the whole file must match on completion.",
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "pushArgs": {
      "type": "object",
      "required": ["path", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "size": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "pullArgs": { "type": "object", "required": ["path"], "additionalProperties": false, "properties": { "path": { "$ref": "#/$defs/path" } } },
    "transferResult": {
      "type": "object",
      "required": ["transferId"],
      "additionalProperties": false,
      "properties": {
        "transferId": { "type": "integer", "minimum": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cancelArgs": { "type": "object", "required": ["transferId"], "additionalProperties": false, "properties": { "transferId": { "type": "integer", "minimum": 1 } } }
  },
  "oneOf": [
    { "required": ["cmd"], "properties": { "cmd": { "const": "files.push" }, "args": { "$ref": "#/$defs/pushArgs" } } },
    { "required": ["cmd"], "properties": { "cmd": { "const": "files.pull" }, "args": { "$ref": "#/$defs/pullArgs" } } },
    { "required": ["cmd"], "properties": { "cmd": { "const": "files.cancel" }, "args": { "$ref": "#/$defs/cancelArgs" } } },
    { "required": ["evt"], "properties": { "evt": { "const": "file.progress" }, "data": {
      "type": "object", "required": ["transferId", "bytes", "total"],
      "additionalProperties": false,
      "properties": {
        "transferId": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    } } }
  ]
}
