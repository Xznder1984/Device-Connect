{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://device-connect.local/schema/messages.schema.json",
  "title": "Messages/SMS channel (0x04) commands and events",
  "description": "SMS only in v1. MMS and third-party chat apps are not directly accessible; replies to those apps go through the notifications channel inline-reply flow.",
  "$defs": {
    "sms": {
      "type": "object",
      "required": ["id", "address", "body", "sent", "time"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "address": { "type": "string", "maxLength": 40 },
        "name": { "type": "string", "maxLength": 100 },
        "body": { "type": "string", "maxLength": 10000 },
        "sent": { "type": "boolean" },
        "read": { "type": "boolean" },
        "time": { "type": "integer", "minimum": 0 }
      }
    },
    "listArgs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
        "beforeId": { "type": "integer", "minimum": 0 }
      }
    },
    "listResult": { "type": "object", "required": ["items"], "additionalProperties": false, "properties": { "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/sms" } } } },
    "threadArgs": {
      "type": "object",
      "required": ["address"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "minLength": 1, "maxLength": 40 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "sendArgs": {
      "type": "object",
      "required": ["to", "text"],
      "additionalProperties": false,
      "properties": {
        "to": { "type": "string", "minLength": 1, "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "sendResult": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "type": "integer", "minimum": 0 } } }
  },
  "oneOf": [
    { "required": ["cmd"], "properties": { "cmd": { "const": "sms.list" }, "args": { "$ref": "#/$defs/listArgs" } } },
    { "required": ["cmd"], "properties": { "cmd": { "const": "sms.thread" }, "args": { "$ref": "#/$defs/threadArgs" } } },
    { "required": ["cmd"], "properties": { "cmd": { "const": "sms.send" }, "args": { "$ref": "#/$defs/sendArgs" } } },
    { "required": ["evt"], "properties": { "evt": { "const": "sms.received" }, "data": { "$ref": "#/$defs/sms" } } }
  ]
}
