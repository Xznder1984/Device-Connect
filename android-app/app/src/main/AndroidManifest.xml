<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Device Connect lets one person control their own phone from their own PC.
      Every capability below is opt-in on the device, and the app shows a
      permanent notification whenever remote control or screen capture is
      active. Nothing is uploaded to any server: the connection is direct,
      device to device, end-to-end encrypted with Noise.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      The camera is only used to scan the pairing QR code the PC shows, and is
      requested at runtime the first time the user chooses "Scan QR code".
      It is optional so the app still installs on devices without one (they can
      pair by typing the address, or over mDNS).
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      Android 17 (API 37) will gate local network access behind
      ACCESS_LOCAL_NETWORK. This app targets API 36, where local network access
      is implicitly granted by INTERNET, and the platform docs say not to
      declare or request the permission until the target SDK is raised. When
      targetSdk moves to 37 this manifest must add:
        <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
      and request it at runtime. See docs/android.md, "Local network access".
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceConnect">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DeviceConnect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hosts an active session. The connectedDevice type is what Android
          requires for a service that keeps a device-to-device link up, and it
          is also the honest description: this service exists only to hold the
          connection your PC asked for. The notification it posts is the
          consent surface and cannot be dismissed without disconnecting.
        -->
        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
