<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a phone with a screen, drawn inside the 72dp safe zone
  of the 108dp adaptive-icon canvas. Vector only, so no bitmaps are committed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M43,29 h22 a6,6 0 0 1 6,6 v38 a6,6 0 0 1 -6,6 h-22 a6,6 0 0 1 -6,-6 v-38 a6,6 0 0 1 6,-6 z" />

    <!-- Screen -->
    <path
        android:fillColor="#1F6FEB"
        android:pathData="M43,38 h22 v30 h-22 z" />

    <!-- Earpiece -->
    <path
        android:fillColor="#0B1220"
        android:pathData="M50,33 h8 v2 h-8 z" />

    <!-- Home indicator -->
    <path
        android:fillColor="#1F6FEB"
        android:pathData="M51,71.5 h6 v2 h-6 z" />

    <!-- Link ticks to the right of the phone -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76,46 h4 v4 h-4 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M76,58 h4 v4 h-4 z" />

</vector>
